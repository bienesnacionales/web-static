# Dependencias
node_modules/
 
# Salida de build (incluye el índice de Pagefind, que se genera en dist/)
dist/
 
# Artefactos de Astro y Vite (tipos generados, caché de dependencias)
.astro/
.vite/
 
# Entorno: las variables (PUBLIC_GA_ID, PUBLIC_SITE_URL, SITIO_PUBLICO) se
# definen en CI/CD o en un .env local que no se versiona.
.env
.env.*
!.env.example
 
# Logs
*.log
npm-debug.log*
 
# Sistema operativo / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
 
# Configuración local de agentes: rutas de la máquina, no compartible.
.claude/ 
# Videos y presentaciones del contenido: pesan decenas de MB y algunos superan
# el límite de 25 MB por archivo de Cloudflare, así que no se versionan. Los
# PDF, planillas y documentos Word de public/uploads sí se publican.
public/uploads/**/*.mp4
public/uploads/**/*.pptx

# Informes generados (Excel de enlaces rotos).
informes/

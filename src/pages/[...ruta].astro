---
/**
 * Todas las páginas del sitio salvo la portada, la 404 y la búsqueda.
 *
 * Cada una es un JSON en `src/contenido/paginas/` con el `<main>` original y
 * sus datos de cabecera. La ruta del archivo es la URL de la página.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { paraIndice } from '@/lib/indice';

export interface Pagina {
  ruta: string;
  titulo: string;
  descripcion: string;
  imagen: string;
  clases: string;
  /** Noticia, Trámite o Página: la etiqueta que muestra la búsqueda. */
  tipo: string;
  instagram: boolean;
  /** Extracto para los resultados de la búsqueda del sitio. */
  resumen: string;
  html: string;
}

export function getStaticPaths() {
  const paginas = import.meta.glob<Pagina>('/src/contenido/paginas/**/*.json', {
    eager: true,
    import: 'default',
  });
  return Object.values(paginas)
    .filter((p) => p.ruta !== '/')
    .map((pagina) => ({ params: { ruta: pagina.ruta.slice(1, -1) }, props: { pagina } }));
}

const { pagina } = Astro.props;

/*
  Los listados de noticias y de trámites quedan fuera del buscador: su texto es
  el de las tarjetas, que ya aparecen como resultados propios.
*/
const esListado = /data-mbn-(news|procedure)-search[\s>]/.test(pagina.html);
const html = esListado ? pagina.html : paraIndice(pagina.html, pagina.tipo, pagina.resumen);
---

<BaseLayout
  titulo={pagina.titulo}
  descripcion={pagina.descripcion}
  imagen={pagina.imagen}
  clases={pagina.clases}
  instagram={pagina.instagram}
>
  <Fragment set:html={html} />
</BaseLayout>

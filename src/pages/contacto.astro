---
/**
 * Página de contacto.
 *
 * El sitio es estático y no procesa envíos: las consultas se canalizan por el
 * formulario del Sistema Integral de Atención Ciudadana (SIAC) del Ministerio
 * de Bienes Nacionales. Esta página explica esa ruta y entrega los datos
 * institucionales de la Oficina Técnica de Comunidades Agrícolas.
 *
 * Dirección y teléfono según el pie del sitio antiguo comunidadesagricolas.cl
 * (Seremi de Bienes Nacionales Región de Coquimbo). Nota: los PDF de la Ley y
 * de los Estatutos indican «Prat 255»; el sitio decía «Prat 225». Se usa el
 * dato del sitio por ser el más reciente — confirmar con la contraparte.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';

const FORMULARIO_MINISTERIO = 'https://www.bienesnacionales.cl/siac-atencion/infoAtencion.html';
---

<BaseLayout
  titulo="Contacto"
  descripcion="Canalice sus consultas sobre Comunidades Agrícolas a través del formulario de atención ciudadana del Ministerio de Bienes Nacionales."
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="max-w-3xl">
      <p class="eyebrow">Contacto</p>
      <h1
        class="mt-3 font-display text-4xl font-bold tracking-tight text-slate-900
               sm:text-5xl dark:text-white"
      >
        Escríbanos a través del Ministerio
      </h1>
      <p class="mt-6 text-lg text-slate-600 dark:text-slate-400">
        Las consultas, solicitudes y reclamos sobre Comunidades Agrícolas se reciben por el
        formulario de atención ciudadana del Ministerio de Bienes Nacionales. Desde ahí se
        derivan a la Oficina Técnica de Comunidades Agrícolas.
      </p>
    </header>

    <div class="mt-14 grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
      <section
        class="tarjeta flex flex-col justify-between gap-8 p-8 sm:p-10"
        aria-labelledby="formulario-titulo"
      >
        <div>
          <h2
            id="formulario-titulo"
            class="font-display text-2xl font-bold tracking-tight text-slate-900 dark:text-white"
          >
            Formulario de atención ciudadana
          </h2>
          <p class="mt-4 text-slate-600 dark:text-slate-400">
            Use el botón para acceder al formulario del Ministerio de Bienes Nacionales.
            Ahí podrá ingresar su consulta y hacer seguimiento de su solicitud. Indique en
            el motivo que su consulta se refiere a
            <strong
              class="font-semibold text-slate-900 dark:text-white"
            >«Comunidades Agrícolas»</strong>.
          </p>
          <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">
            Si su consulta es sobre el trámite de adjudicaciones, mencione la comunidad a la
            que pertenece y su relación con el comunero titular para agilizar la derivación.
          </p>
        </div>

        <a
          href={FORMULARIO_MINISTERIO}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 self-start rounded-2xl
                 bg-comunidad-700 px-7 py-4 text-base font-semibold text-white transition-colors
                 hover:bg-comunidad-800"
        >
          Ir al formulario de contacto
          <span aria-hidden="true">→</span>
          <span class="sr-only">(se abre en una ventana nueva)</span>
        </a>
      </section>

      <section class="tarjeta p-8 sm:p-10" aria-labelledby="institucional-titulo" id="institucional">
        <h2
          id="institucional-titulo"
          class="font-display text-2xl font-bold tracking-tight text-slate-900 dark:text-white"
        >
          Información institucional
        </h2>

        <dl class="mt-8 space-y-7">
          <div>
            <dt class="eyebrow">Organismo</dt>
            <dd class="mt-2 text-slate-700 dark:text-slate-300">
              Oficina Técnica de Comunidades Agrícolas<br />
              Seremi de Bienes Nacionales — Región de Coquimbo
            </dd>
          </div>

          <div>
            <dt class="eyebrow">Dirección</dt>
            <dd class="mt-2 not-italic text-slate-700 dark:text-slate-300">
              <address class="not-italic">
                Av. Arturo Prat 225, oficina 410<br />
                La Serena, Chile
              </address>
            </dd>
          </div>

          {/*
            Los números van como enlace `tel:` y no como texto suelto: en un
            móvil un teléfono escrito obliga a copiarlo a mano. `inline-flex
            min-h-6` para alcanzar los 24px de objetivo táctil (WCAG 2.5.8).
          */}
          <div>
            <dt class="eyebrow">Teléfono</dt>
            <dd class="mt-2 text-slate-700 dark:text-slate-300">
              <a
                href="tel:+5651566500"
                class="inline-flex min-h-6 items-center font-semibold text-comunidad-700
                       hover:underline dark:text-cosecha-400"
              >
                (51) 566 500
              </a>
            </dd>
          </div>

          <div>
            <dt class="eyebrow">Atención ciudadana del Ministerio</dt>
            <dd class="mt-2 text-slate-700 dark:text-slate-300">
              <a
                href="tel:800104559"
                class="inline-flex min-h-6 items-center font-semibold text-comunidad-700
                       hover:underline dark:text-cosecha-400"
              >
                800 104 559
              </a>
            </dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
</BaseLayout>

---
/**
 * Páginas 2 en adelante del listado de noticias. La primera vive en
 * `/noticias` (ver el porqué en `noticias/index.astro`).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListadoNoticias from '@/components/ListadoNoticias.astro';
import { contarPaginas, listarPagina, listarNoticias } from '@/lib/news';

export async function getStaticPaths() {
  const total = await contarPaginas();
  // Desde la 2: la primera página es `/noticias`.
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { pagina: String(i + 2) },
  }));
}

const numero = Number(Astro.params.pagina);
const { noticias, actual, total } = await listarPagina(numero);
const totalNoticias = (await listarNoticias()).length;
---

<BaseLayout
  titulo={`Noticias — página ${actual}`}
  descripcion="Noticias de las Comunidades Agrícolas de Chile y de la Oficina Técnica del Ministerio de Bienes Nacionales."
>
  <ListadoNoticias
    noticias={noticias}
    actual={actual}
    total={total}
    totalNoticias={totalNoticias}
  />
</BaseLayout>

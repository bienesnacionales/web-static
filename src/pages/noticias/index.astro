---
/**
 * Primera página del listado. Las siguientes viven en
 * `/noticias/pagina/[pagina].astro`.
 *
 * La primera no es `/noticias/pagina/1` a propósito: dos URL con el mismo
 * contenido se reparten la autoridad de enlace y obligan a un canonical.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListadoNoticias from '@/components/ListadoNoticias.astro';
import { listarPagina, listarNoticias } from '@/lib/news';

const { noticias, actual, total } = await listarPagina(1);
const totalNoticias = (await listarNoticias()).length;
---

<BaseLayout
  titulo="Noticias"
  descripcion="Noticias de las Comunidades Agrícolas de Chile y de la Oficina Técnica del Ministerio de Bienes Nacionales."
>
  <ListadoNoticias
    noticias={noticias}
    actual={actual}
    total={total}
    totalNoticias={totalNoticias}
  />
</BaseLayout>

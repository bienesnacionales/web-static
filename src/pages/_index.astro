---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MetricCard from '@/components/MetricCard.astro';
import NewsCard from '@/components/NewsCard.astro';
import PageCard from '@/components/PageCard.astro';
import HeroCarousel from '@/components/HeroCarousel.tsx';
import { listarDestacadas } from '@/lib/news';
import { obtenerDiapositivas } from '@/lib/carousel';

const destacadas = await listarDestacadas(3);
// Se resuelve en el servidor: Astro genera aquí las variantes WebP y a la isla
// le llegan `src` y `srcset` ya calculados. Ver `src/lib/carousel.ts`.
const diapositivas = await obtenerDiapositivas();

/*
  Accesos principales de la portada. Espejan la navegación; si una sección
  cambia de ruta hay que actualizarla también aquí.
*/
const secciones = [
  {
    titulo: 'Quiénes Somos',
    descripcion:
      'La Oficina Técnica de Comunidades Agrícolas del Ministerio de Bienes Nacionales: su misión y sus funciones.',
    href: '/quienes-somos',
  },
  {
    titulo: 'Comunidades Agrícolas',
    descripcion:
      'Qué son las Comunidades Agrícolas, cómo se organizan y dónde se encuentran.',
    href: '/comunidades-agricolas',
  },
  {
    titulo: 'Documentación',
    descripcion:
      'Trámite de adjudicaciones, la Ley de Comunidades Agrícolas y estudios de referencia.',
    href: '/documentacion',
  },
  {
    titulo: 'Noticias',
    descripcion:
      'Encuentros, asesorías en terreno y novedades del mundo comunitario agrícola.',
    href: '/noticias',
  },
  {
    titulo: 'Galerías',
    descripcion: 'Registro fotográfico de la vida comunitaria y sus territorios.',
    href: '/galerias',
  },
  {
    titulo: 'Contacto',
    descripcion: 'Canales de atención para comuneros, dirigentes y público general.',
    href: '/contacto',
  },
];
---

{/*
  `cabeceraFlotante`: el carrusel pasa por debajo del menú. Es la única página
  que lo pide, porque es la única con Hero a sangre.
*/}
<BaseLayout titulo="Inicio" cabeceraFlotante>
  {/*
    El diseño no incluye un título de página visible: el protagonismo es del
    carrusel. Este `h1` oculto da a lectores de pantalla y rastreadores el
    encabezado que la página necesita, sin alterar el diseño.
  */}
  <h1 class="sr-only">Comunidades Agrícolas de Chile — Ministerio de Bienes Nacionales</h1>

  {/*
    Carrusel Hero. `client:load` y no `client:idle`: los controles deben
    responder al primer clic.
  */}
  <HeroCarousel diapositivas={diapositivas} client:load />

  {/*
    Cifras de contexto.

    **Las cuatro son datos por confirmar con la Oficina Técnica** (número de
    comunidades, superficie y regiones): se dejaron valores de referencia
    habituales en la literatura sobre CCAA para que la portada no salga vacía,
    pero deben validarse antes del lanzamiento.
  */}
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8" aria-labelledby="metricas-titulo">
    <p class="eyebrow">Las comunidades en cifras</p>
    <h2
      id="metricas-titulo"
      class="mt-3 max-w-2xl font-display text-3xl font-bold tracking-tight
             text-slate-900 sm:text-4xl dark:text-white"
    >
      Un patrimonio colectivo del mundo campesino
    </h2>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <MetricCard
        valor="1968"
        etiqueta="D.F.L. N°5"
        detalle="La Ley de Comunidades Agrícolas que las regula"
      />
      {/* Fuente: sitio antiguo comunidadesagricolas.cl y noticia del
          encuentro nacional de diciembre de 2017. */}
      <MetricCard
        valor="187"
        etiqueta="Comunidades"
        detalle="177 de ellas en la Región de Coquimbo"
      />
      {/* Fuente: «Estatutos de la Comunidad Agrícola — Modelo Tipo», Seremi
          de Bienes Nacionales Región de Coquimbo (presentación). */}
      <MetricCard
        valor="25%"
        etiqueta="De la propiedad rural"
        detalle="De la Región de Coquimbo está bajo este régimen"
      />
      <MetricCard
        valor="Asamblea"
        etiqueta="Gestión colectiva"
        detalle="Las decisiones se toman en comunidad"
      />
    </div>
  </section>

  {/* Accesos a las secciones del sitio */}
  <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8" aria-labelledby="secciones-titulo">
    <p class="eyebrow">Explore el sitio</p>
    <h2
      id="secciones-titulo"
      class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900
             sm:text-4xl dark:text-white"
    >
      Información y servicios para el mundo comunitario
    </h2>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {secciones.map((s) => <PageCard {...s} nivel={3} />)}
    </div>
  </section>

  {/* Noticias destacadas */}
  {
    destacadas.length > 0 && (
      <section
        class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8"
        aria-labelledby="noticias-titulo"
      >
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">Actualidad</p>
            <h2
              id="noticias-titulo"
              class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
            >
              Noticias
            </h2>
          </div>
          <a
            href="/noticias"
            class="font-semibold text-comunidad-700 hover:underline dark:text-cosecha-400"
          >
            Ver todas las noticias <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {destacadas.map((noticia) => (
            <NewsCard noticia={noticia} />
          ))}
        </div>
      </section>
    )
  }

  {/* Misión de la Oficina Técnica */}
  <section
    class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8"
    aria-labelledby="mision-titulo"
  >
    <div class="tarjeta grid gap-10 p-8 sm:p-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
      <div>
        <p class="eyebrow">Nuestra misión</p>
        <h2
          id="mision-titulo"
          class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900
                 dark:text-white"
        >
          Fortalecer la naturaleza comunitaria de sus derechos
        </h2>
      </div>
      <div class="space-y-5 text-slate-600 dark:text-slate-400">
        <p>
          La Oficina Técnica de Comunidades Agrícolas coordina las intervenciones que las
          diversas instancias del Ministerio de Bienes Nacionales realizan en el contexto
          comunitario agrícola, colaborando en la integración de las Comunidades Agrícolas
          a los procesos de desarrollo.
        </p>
        <p>
          Todo ello respetando la autonomía de cada comunidad y su libertad para elegir el
          camino que mejor se adecue a las decisiones mayoritarias de cada asamblea.
        </p>
        <a
          href="/quienes-somos"
          class="inline-flex items-center gap-2 font-semibold text-comunidad-700
                 hover:underline dark:text-cosecha-400"
        >
          Conozca la Oficina Técnica <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

---
/*
  Portada provisional de mantención. La portada real quedó en `_index.astro`:
  el `_` la deja fuera de las rutas. Para restaurarla, borrar este archivo y
  devolverle su nombre.

  No usa BaseLayout a propósito: sin cabecera, pie ni menú, que llevarían a
  secciones que se presentan como en mantención.

  Fondo blanco y no `bg-lienzo`: el logo trae su propio bloque blanco.
*/
import '@fontsource-variable/inter';
import '@fontsource-variable/plus-jakarta-sans';
import '@/styles/global.css';
import logoMinisterio from '@/assets/marca/bienes-nacionales.svg?url';
import { politicaCsp } from '@/lib/seguridad';
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="content-security-policy" content={politicaCsp()} />

    <title>Sitio en Mantención — Ministerio de Bienes Nacionales</title>
    <meta name="description" content="Sitio en mantención. Pronta nueva web." />
    {/* Una página de mantención nunca debe quedar en el índice de un buscador. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="grid min-h-dvh place-items-center bg-white px-4 py-12 text-center">
    <main class="flex flex-col items-center">
      <img
        src={logoMinisterio}
        alt="Ministerio de Bienes Nacionales, Gobierno de Chile"
        width="200"
        height="181"
        fetchpriority="high"
      />
      <h1
        class="mt-10 font-display text-3xl font-bold tracking-tight text-comunidad-800
               sm:text-4xl"
      >
        Sitio en Mantención
      </h1>
      <p class="mt-3 text-lg text-slate-600 sm:text-xl">Pronta nueva Web</p>
    </main>
  </body>
</html>

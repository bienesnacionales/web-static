---
/*
  La portada depende del modo del build: con `MODO_MANTENCION=true` es la de
  «Sitio en Mantención»; sin él, la portada del sitio.
*/
import BaseLayout from '@/layouts/BaseLayout.astro';
import Mantencion from '@/components/Mantencion.astro';
import inicio from '@/contenido/paginas/inicio.json';
import { MODO_MANTENCION } from '@/lib/publicacion';
import { paraIndice } from '@/lib/indice';

const html = paraIndice(inicio.html, inicio.tipo, inicio.resumen);
---

{
  MODO_MANTENCION ? (
    <Mantencion />
  ) : (
    <BaseLayout titulo={inicio.titulo} descripcion={inicio.descripcion} clases={inicio.clases} portada>
      <Fragment set:html={html} />
    </BaseLayout>
  )
}

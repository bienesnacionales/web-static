---
/**
 * Galerías fotográficas.
 *
 * Estructura lista para recibir las fotografías: cada galería es una entrada
 * de `GALERIAS` con su carpeta de imágenes en `src/assets/galerias/<id>/`.
 * Mientras no haya material, las tarjetas muestran un marcador con degradado
 * de marca en lugar de la portada.
 *
 * Cuando lleguen las fotos: importar con `import.meta.glob` y pintar con
 * `<Image>` de astro:assets para obtener WebP, `srcset` y dimensiones reales.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';

const GALERIAS = [
  {
    id: 'encuentro-nacional',
    titulo: 'Encuentro Nacional de Comunidades Agrícolas',
    descripcion:
      'El seminario nacional realizado en la Comunidad Agrícola Peral Ojo de Agua, Ovalle, en noviembre de 2017.',
  },
  {
    id: 'territorio',
    titulo: 'Territorio y paisaje',
    descripcion:
      'Los campos comunes, las lluvias y los paisajes del secano donde viven las comunidades.',
  },
  {
    id: 'vida-comunitaria',
    titulo: 'Vida comunitaria',
    descripcion:
      'Asambleas, trabajos comunitarios y la vida cotidiana de comuneras y comuneros.',
  },
  {
    id: 'actividades',
    titulo: 'Actividades y encuentros',
    descripcion:
      'Capacitaciones, celebraciones y encuentros del mundo comunitario agrícola.',
  },
];
---

<BaseLayout
  titulo="Galerías"
  descripcion="Registro fotográfico de las Comunidades Agrícolas de Chile: territorio, vida comunitaria y encuentros."
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="max-w-3xl">
      <p class="eyebrow">Galerías</p>
      <h1
        class="mt-3 font-display text-4xl font-bold tracking-tight text-slate-900
               sm:text-5xl dark:text-white"
      >
        El mundo comunitario en imágenes
      </h1>
      <p class="mt-6 text-lg text-slate-600 dark:text-slate-400">
        Un registro fotográfico de los territorios, las personas y las actividades de las
        Comunidades Agrícolas de Chile.
      </p>
    </header>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        GALERIAS.map((galeria) => (
          <article class="tarjeta overflow-hidden">
            {/* Marcador de portada mientras no lleguen las fotografías. */}
            <div
              class="grid aspect-video place-items-center bg-gradient-to-br
                     from-comunidad-700 via-comunidad-600 to-tierra-500"
            >
              <span
                class="rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold text-white"
              >
                Fotografías próximamente
              </span>
            </div>
            <div class="p-6">
              <h2 class="font-display text-lg font-semibold text-slate-900 dark:text-white">
                {galeria.titulo}
              </h2>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
                {galeria.descripcion}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-12 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Las galerías se encuentran en preparación. Si desea aportar fotografías de su
      comunidad, escríbanos a través de la página de
      <a href="/contacto" class="font-medium text-comunidad-700 underline dark:text-cosecha-400"
        >contacto</a
      >.
    </p>
  </div>
</BaseLayout>

{"ruta": "/noticias/regularizacion-titulos-dominio-emergencias-senado/", "titulo": "Regularización de títulos de dominio en emergencias avanza al Senado tras aprobación unánime – Ministerio de bienes nacionales", "descripcion": "", "imagen": "", "clases": "wp-singular post-template-default single single-post postid-55773 single-format-standard wp-embed-responsive wp-theme-mbn", "tipo": "Noticia", "instagram": false, "html": "<main id=\"primary\" class=\"site-main\">\n\t\t\t<article class=\"mbn-single post-55773 post type-post status-publish format-standard has-post-thumbnail hentry category-titulos-de-dominio tag-catalina-parot tag-congreso tag-emergencias tag-regularizacion\">\n\t\t\t<div class=\"mbn-container mbn-single__container\">\n\t\t\t\t<nav\n\tclass=\"mbn-breadcrumbs\"\n\taria-label=\"Ubicación\"\n\t\tstyle=\"--mbn-breadcrumbs-chevron: url('/tema/images/components/icon-keyboard-arrow-right.svg');\"\n\t>\n\t<ol class=\"mbn-breadcrumbs__list\">\n\t\t\t\t\t<li class=\"mbn-breadcrumbs__item\">\n\t\t\t\t\t\t\t\t\t<a class=\"mbn-breadcrumbs__link\" href=\"/\">Inicio</a>\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t<span class=\"mbn-breadcrumbs__separator\" aria-hidden=\"true\"></span>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t<li class=\"mbn-breadcrumbs__item\">\n\t\t\t\t\t\t\t\t\t<a class=\"mbn-breadcrumbs__link\" href=\"/noticias/\">Noticias</a>\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t<span class=\"mbn-breadcrumbs__separator\" aria-hidden=\"true\"></span>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t<li class=\"mbn-breadcrumbs__item mbn-breadcrumbs__item--current\">\n\t\t\t\t\t\t\t\t\t<span\n\t\t\t\t\t\tclass=\"mbn-breadcrumbs__label\"\n\t\t\t\t\t\t\t\t\t\t\t\taria-current=\"page\"\n\t\t\t\t\t\t\t\t\t\t\t>Regularización de títulos de dominio en emergencias avanza al Senado tras…</span>\n\t\t\t\t\n\t\t\t\t\t\t\t</li>\n\t\t\t</ol>\n</nav>\n<div\n\tclass=\"mbn-share\"\n\tdata-mbn-share\n\tdata-mbn-share-error=\"No se pudo copiar el mensaje. Copia el enlace de esta página.\"\n>\n\t\t\t<span class=\"mbn-share__labe
---
/**
 * Índice de las secciones de una página de contenido.
 *
 * ## De dónde salen las entradas
 *
 * De `render()`, que devuelve los encabezados del Markdown ya con su `id`
 * puesto. No hay lista que mantener: quien escribe la página pone sus `##` y el
 * índice aparece solo. Se toman **sólo los de segundo nivel**; con los `###`
 * dentro, el índice de una página larga se convierte en otra página larga.
 *
 * ## Cuándo se dibuja
 *
 * A partir de `MINIMO_SECCIONES`. Por debajo de ese punto el índice repite lo
 * que ya se ve desplazando media pantalla, y un bloque que no aporta una
 * categoría real sobra (DISENO §2.3). El umbral lo aplica `[...ruta].astro`,
 * que es quien sabe cuántas secciones tiene la página.
 *
 * Lo que motivó el componente: el Plan de Acción, con ocho secciones y —antes de
 * plegar sus acciones— veintiuna pantallas de alto, no ofrecía forma de saltar a
 * la Carta Gantt que no fuera arrastrar el ratón.
 *
 * ## Dos variantes, por el mismo motivo que `MenuManuales`
 *
 * En escritorio ocupa la columna de 16rem, bajo «Al mismo nivel». En móvil esa
 * columna **se apila al final del artículo**, y un índice al que hay que llegar
 * atravesando la página entera no es un índice: allí va arriba, plegado en un
 * `<details>`. Sólo se dibuja una de las dos a la vez, así que el lector de
 * pantalla y el tabulador ven un único índice.
 *
 * El porqué largo de este reparto está escrito en `MenuManuales.astro`, que lo
 * estrenó; vale aquí sin cambios.
 */
import type { MarkdownHeading } from 'astro';

/** Desde cuántas secciones vale la pena un índice. */
export const MINIMO_SECCIONES = 5;

interface Props {
  encabezados: MarkdownHeading[];
  /**
   * `movil` va plegado y arriba del artículo; `escritorio`, desplegado y en la
   * columna lateral. Cada uno se oculta en el ancho del otro.
   */
  variante: 'movil' | 'escritorio';
}

const { encabezados, variante } = Astro.props;

const secciones = encabezados.filter((h) => h.depth === 2);
---

{/* `data-pagefind-ignore`: el índice repite los títulos de la propia página. */}
<nav
  aria-label="Secciones de esta página"
  data-pagefind-ignore
  class:list={[
    variante === 'movil'
      ? 'lg:hidden'
      : /*
          Quien fija esta columna es el `<aside>` de `[...ruta].astro`: allí
          están el `sticky`, el `self-start` que lo hace posible y el alto máximo
          del conjunto. Aquí sólo se decide en qué ancho se ve, porque el índice
          no sabe —ni debe— con qué más comparte columna.
        */
        'hidden lg:block',
  ]}
>
  <details
    class:list={[
      variante === 'movil'
        ? 'tarjeta group mb-10 px-4 py-3'
        : // En escritorio va abierto de fábrica y sin tirador: no hay nada que
          // plegar en una columna que existe justo para esto.
          '[&>summary]:hidden',
    ]}
    open={variante === 'escritorio'}
  >
    <summary
      class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3
             text-sm font-semibold text-slate-900 dark:text-white"
    >
      <span>En esta página</span>
      <svg
        class="size-5 shrink-0 transition-transform group-open:rotate-180"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
          clip-rule="evenodd"
        />
      </svg>
    </summary>

    {/*
      `aria-labelledby` sobre un `<p>` y no un `<h3>`: los encabezados de la
      página los ocupa su contenido, y meter aquí los del índice rompería la
      jerarquía sin saltos (DISENO §11.5). El `id` lleva la variante dentro
      porque el componente se dibuja dos veces por página.
    */}
    {
      variante === 'escritorio' && (
        <p id="indice-escritorio" class="eyebrow">
          En esta página
        </p>
      )
    }

    <ul
      aria-labelledby={variante === 'escritorio' ? 'indice-escritorio' : undefined}
      class:list={['space-y-0.5', variante === 'escritorio' ? 'mt-4' : 'mt-3 pb-1']}
    >
      {
        secciones.map((seccion) => (
          <li>
            <a
              href={`#${seccion.slug}`}
              class="flex min-h-6 rounded-xl px-3 py-2 text-sm text-slate-600 transition-colors
                     hover:bg-comunidad-50 hover:text-comunidad-800 dark:text-slate-400
                     dark:hover:bg-slate-800 dark:hover:text-white"
            >
              {seccion.text}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</nav>

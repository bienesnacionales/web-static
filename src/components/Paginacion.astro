---
/**
 * Navegación entre páginas de un listado.
 *
 * Los extremos inactivos no se renderizan. La alternativa —dejarlos atenuados—
 * crea dos problemas: un elemento con aspecto de enlace que no lo es, y texto
 * gris que no llega al contraste mínimo (medido: 2,35:1 sobre fondo oscuro).
 * Los números de página ya indican dónde está el usuario.
 */
import { ChevronLeft, ChevronRight } from 'lucide-react';

interface Props {
  actual: number;
  total: number;
  /** Construye la URL de cada página. */
  ruta: (numero: number) => string;
  /** Se usa en el `aria-label` del nav, por si hay más de un paginador. */
  etiqueta?: string;
}

const { actual, total, ruta, etiqueta = 'Paginación' } = Astro.props;

/**
 * Ventana de números alrededor de la página actual. Con 14 páginas dibujarlas
 * todas satura la barra y empeora en cuanto crezca el archivo de noticias.
 * Siempre se muestran la primera y la última para poder saltar a los extremos.
 */
function ventana(actual: number, total: number): (number | 'salto')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

  const cerca = new Set([1, total, actual, actual - 1, actual + 1]);
  if (actual <= 3) [2, 3, 4].forEach((n) => cerca.add(n));
  if (actual >= total - 2) [total - 3, total - 2, total - 1].forEach((n) => cerca.add(n));

  const paginas = [...cerca].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);

  const salida: (number | 'salto')[] = [];
  paginas.forEach((n, i) => {
    if (i > 0 && n - paginas[i - 1] > 1) salida.push('salto');
    salida.push(n);
  });
  return salida;
}

const numeros = ventana(actual, total);

const claseExtremo =
  'flex items-center gap-1.5 rounded-xl border border-slate-300 px-4 py-2.5 text-sm ' +
  'font-medium text-slate-700 transition-colors hover:bg-white dark:border-slate-700 ' +
  'dark:text-slate-300 dark:hover:bg-slate-800';
---

{
  total > 1 && (
    <nav aria-label={etiqueta} class="mt-16 flex flex-wrap items-center justify-center gap-3">
      {actual > 1 && (
        <a href={ruta(actual - 1)} class={claseExtremo} rel="prev">
          <ChevronLeft aria-hidden="true" className="size-4" />
          Anterior
        </a>
      )}

      <ol class="flex items-center gap-1.5">
        {numeros.map((n) => (
          <li>
            {n === 'salto' ? (
              <span class="px-1 text-slate-600 dark:text-slate-400" aria-hidden="true">
                …
              </span>
            ) : n === actual ? (
              <span
                aria-current="page"
                class="grid size-11 place-items-center rounded-xl bg-comunidad-700 text-sm
                       font-semibold text-white"
              >
                {n}
                <span class="sr-only">, página actual</span>
              </span>
            ) : (
              <a
                href={ruta(n)}
                class="grid size-11 place-items-center rounded-xl border border-slate-300
                       text-sm font-medium text-slate-700 transition-colors hover:bg-white
                       dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
              >
                {n}
                <span class="sr-only">Ir a la página {n}</span>
              </a>
            )}
          </li>
        ))}
      </ol>

      {actual < total && (
        <a href={ruta(actual + 1)} class={claseExtremo} rel="next">
          Siguiente
          <ChevronRight aria-hidden="true" className="size-4" />
        </a>
      )}
    </nav>
  )
}

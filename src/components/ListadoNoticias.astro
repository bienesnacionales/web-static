---
/**
 * Cuerpo del listado de noticias, compartido por `/noticias` y
 * `/noticias/pagina/N` para que ambas rutas no dupliquen el maquetado.
 */
import NewsCard from '@/components/NewsCard.astro';
import Paginacion from '@/components/Paginacion.astro';
import { rutaPagina, POR_PAGINA, type Noticia } from '@/lib/news';

interface Props {
  noticias: Noticia[];
  actual: number;
  total: number;
  totalNoticias: number;
}

const { noticias, actual, total, totalNoticias } = Astro.props;

const desde = (actual - 1) * POR_PAGINA + 1;
const hasta = Math.min(actual * POR_PAGINA, totalNoticias);
---

<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <header>
    <p class="eyebrow">Comunicaciones</p>
    <h1
      class="mt-3 font-display text-4xl font-bold tracking-tight text-slate-900
             sm:text-5xl dark:text-white"
    >
      Noticias
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
      Novedades de las Comunidades Agrícolas y del trabajo de la Oficina Técnica del
      Ministerio de Bienes Nacionales: encuentros, asesorías en terreno y vida
      comunitaria.
    </p>
  </header>

  {
    total > 1 && (
      <p class="mt-8 text-sm text-slate-600 dark:text-slate-400">
        Mostrando <strong class="font-semibold text-slate-900 dark:text-white">
          {desde}–{hasta}
        </strong>{' '}
        de {totalNoticias} noticias · página {actual} de {total}
      </p>
    )
  }

  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {noticias.map((noticia) => <NewsCard noticia={noticia} nivel={2} />)}
  </div>

  <Paginacion actual={actual} total={total} ruta={rutaPagina} etiqueta="Paginación de noticias" />
</div>

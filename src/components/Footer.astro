---
/*
  El logo del Ministerio va por `?url` y se pinta con un `<img>` normal, no con
  el `<Image>` de astro:assets: éste sirve para rasterizar y redimensionar, y
  un SVG no necesita ninguna de las dos cosas. Tampoco se incrusta en el
  marcado: pesa ~96 KB y en línea se repetiría dentro del HTML de cada página;
  como archivo aparte se descarga una vez y queda cacheado.
*/
import logoMinisterio from '@/assets/marca/bienes-nacionales.svg?url';
import { navegacionPublicada } from '@/lib/publicacion';

const anio = new Date().getFullYear();

// Mismo cálculo que la cabecera: el pie no puede enlazar a una sección apagada.
const { navegacion, accesosRapidos } = await navegacionPublicada();

const conSubniveles = navegacion.filter((s) => s.columnas.length > 0);
const directas = navegacion.filter((s) => s.columnas.length === 0);
---

{/* Fuera del índice de búsqueda: se repite en todas las páginas. */}
<footer
  data-pagefind-ignore
  class="mt-24 border-t border-slate-200/60 bg-white dark:border-slate-800 dark:bg-slate-950"
>
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    {/*
      Tres columnas: la marca, una por cada sección con subniveles —hoy sólo
      Documentación— y la de «Más». **Si se enciende o se apaga una sección con
      subniveles, hay que revisar este número**: Tailwind sólo genera las
      clases que encuentra escritas, así que una construida al vuelo
      (`lg:grid-cols-${n}`) se purgaría del CSS.
    */}
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <p class="font-display text-lg font-bold text-comunidad-800 dark:text-white">
          Ministerio de Bienes Nacionales
        </p>

        {/*
          Lleva texto alternativo y no `alt=""` porque el logo aporta algo que
          el pie no dice en ninguna otra parte: el escudo de Gobierno de Chile.
        */}
        <img
          src={logoMinisterio}
          alt="Ministerio de Bienes Nacionales, Gobierno de Chile"
          width="119"
          height="108"
          loading="lazy"
          class="mt-6"
        />
      </div>

      {/*
        Sólo las secciones con subniveles tienen columna propia. Las que se
        enlazan directo van juntas en la última columna. Los enlaces llevan
        `inline-flex min-h-6 items-center` para alcanzar los 24px de objetivo
        táctil que exige WCAG 2.5.8 sin cambiar su aspecto.
      */}
      {conSubniveles.map((seccion) => (
        <nav aria-labelledby={`pie-${seccion.id}`}>
          <p id={`pie-${seccion.id}`} class="eyebrow">{seccion.titulo}</p>
          <ul class="mt-4 space-y-2.5">
            {seccion.columnas.flatMap((col) => col.enlaces).slice(0, 5).map((enlace) => (
              <li>
                <a
                  href={enlace.href}
                  class="inline-flex min-h-6 items-center text-sm text-slate-600
                         hover:text-comunidad-700 hover:underline
                         dark:text-slate-400 dark:hover:text-cosecha-400"
                  {...(enlace.externo
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  {enlace.titulo}
                  {enlace.externo && <span class="sr-only"> (se abre en una ventana nueva)</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      {directas.length > 0 && (
        <nav aria-labelledby="pie-directas">
          <p id="pie-directas" class="eyebrow">Más</p>
          <ul class="mt-4 space-y-2.5">
            {directas.map((seccion) => (
              <li>
                <a
                  href={seccion.href}
                  class="inline-flex min-h-6 items-center text-sm text-slate-600
                         hover:text-comunidad-700 hover:underline
                         dark:text-slate-400 dark:hover:text-cosecha-400"
                >
                  {seccion.titulo}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-slate-200/60 pt-8
             sm:flex-row sm:items-center sm:justify-between dark:border-slate-800"
    >
      <p class="text-sm text-slate-500 dark:text-slate-400">
        © {anio} Ministerio de Bienes Nacionales
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {accesosRapidos.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              class="inline-flex min-h-6 items-center text-sm text-slate-600
                     hover:text-comunidad-700 hover:underline
                     dark:text-slate-400 dark:hover:text-cosecha-400"
              {...(enlace.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {enlace.titulo}
              {enlace.externo && <span class="sr-only"> (se abre en una ventana nueva)</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

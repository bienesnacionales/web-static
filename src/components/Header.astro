---
/**
 * Cabecera del sitio.
 *
 * Escritorio: isla React `MegaMenu`.
 * Móvil / sin JavaScript: `<details>` nativo con la navegación completa, de
 * modo que el sitio siga siendo navegable si la isla no llega a hidratarse.
 */
import MegaMenu from '@/components/MegaMenu.tsx';
import MenuMovil from '@/components/MenuMovil.tsx';
import Buscador from '@/components/Buscador.tsx';
/*
  Logotipo del sitio: firma del Ministerio de Bienes Nacionales, en dos
  variantes por `?url` (archivos cacheables, no inline: en línea se
  repetirían en cada página).

  Son el logotipo anterior —firma + «Comunidades Agrícolas»— recortado a la
  firma con el `viewBox`: el texto sigue dentro del SVG, fuera del área
  visible. Para recuperarlo basta con devolverle el ancho de 359.

  El archivo entregado trae el texto en blanco —pensado para fondo oscuro—,
  así que `firma-ministerio-oscuro.svg` es la misma marca con el texto en
  slate-800 para la cabecera clara. Las barras azul/roja del Gobierno son
  iguales en ambas. Dos `<img>` y no un recolor por CSS: los colores de un
  SVG externo no se pueden tocar desde la página.
*/
import logoMinisterioBlanco from '@/assets/marca/firma-ministerio-blanco.svg?url';
import logoMinisterioOscuro from '@/assets/marca/firma-ministerio-oscuro.svg?url';
import { navegacionPublicada } from '@/lib/publicacion';

interface Props {
  /**
   * La cabecera flota sobre el contenido en vez de empujarlo. Sólo lo pide
   * una página con Hero a sangre; en el resto se queda `sticky` y opaca.
   */
  flotante?: boolean;
}

const { flotante = false } = Astro.props;

/*
  El menú se calcula aquí, en el servidor, y de ahí baja al Mega Menú por props.

  La isla no puede leer la colección de contenido, así que si importara
  `navigation.ts` por su cuenta mostraría el mapa completo mientras el menú
  móvil —renderizado aquí— mostraría sólo lo publicado. Un único cálculo para
  los dos elimina esa posibilidad.
*/
const { navegacion, accesosRapidos } = await navegacionPublicada();

const rutaActual = Astro.url.pathname;
const esActiva = (href: string) =>
  href === '/' ? rutaActual === '/' : rutaActual.startsWith(href);
---

{/*
  `dark` cuando flota, y no una segunda paleta: `global.css` declara
  `@custom-variant dark`, así que esta clase activa todas las variantes `dark:`
  ya escritas aquí y en `MegaMenu.tsx`. `data-sobre-hero` sale ya puesto del
  servidor: el estado transparente es el que se ve al cargar, y quitarlo es
  trabajo del script de más abajo.
*/}
{/* `data-pagefind-ignore`: la cabecera es idéntica en todas las páginas; si se
    indexara, cualquier término del menú devolvería el sitio entero. */}
<header
  data-pagefind-ignore
  data-sobre-hero={flotante ? '' : undefined}
  class:list={[
    'z-50 border-b border-slate-200/60 bg-white/85 backdrop-blur-md transition-colors',
    'dark:border-slate-800 dark:bg-slate-950/85',
    flotante ? 'fixed inset-x-0 top-0 dark' : 'sticky top-0',
  ]}
>
  {/* `h-20` en espejo de `--altura-cabecera` en global.css: si cambia uno,
      cambia el otro. */}
  <div class="mx-auto flex h-20 max-w-7xl items-center gap-6 px-4 sm:px-6 lg:px-8">
    <a href="/" class="shrink-0">
      {/*
        `alt=""` en las dos variantes: el nombre accesible del enlace lo pone
        el `sr-only`; con `alt` en ambas el lector de pantalla lo oiría dos
        veces. `h-16` en todos los anchos: la firma es estrecha y su texto
        pequeño, así que no compite con el buscador y conviene que crezca.
      */}
      <img
        src={logoMinisterioOscuro}
        alt=""
        width="97"
        height="80"
        loading="eager"
        class="h-16 w-auto dark:hidden"
      />
      <img
        src={logoMinisterioBlanco}
        alt=""
        width="97"
        height="80"
        loading="eager"
        class="hidden h-16 w-auto dark:block"
      />
      <span class="sr-only">Ministerio de Bienes Nacionales — Inicio</span>
    </a>

    {/*
      `client:load`: la navegación debe responder al primer clic. Con
      `client:idle` un clic temprano no haría nada, que es peor que el coste
      de hidratar una isla pequeña.
    */}
    <MegaMenu
      client:load
      rutaActual={rutaActual}
      navegacion={navegacion}
      accesosRapidos={accesosRapidos}
    />

    <div class="ml-auto flex items-center gap-2">
      {/*
        `client:idle`: el enlace ya funciona server-rendered (lleva a /buscar),
        así que la isla puede hidratarse sin prisa para mejorarlo con el modal
        y el atajo Cmd+K.
      */}
      <Buscador client:idle />

      {/*
        Menú móvil con hamburguesa que se transforma en aspa (morphicons).
        `client:load`: debe responder al primer toque. Su `xl:hidden` va en
        espejo del `hidden xl:block` del Mega Menú: entre los dos no puede
        quedar ni un hueco ni un solapamiento.
      */}
      <MenuMovil
        client:load
        rutaActual={rutaActual}
        navegacion={navegacion}
        accesosRapidos={accesosRapidos}
      />
    </div>
  </div>
</header>

{
  /*
    Al pasar de largo el Hero, la cabecera recupera su fondo.

    Un `IntersectionObserver` con el borde superior de la raíz metido hacia
    dentro el alto de la cabecera: mientras el Hero siga cruzando esa línea,
    hay fotografía debajo del menú y la cabecera va transparente.

    Se mira `boundingClientRect.bottom` y no `isIntersecting`: el segundo
    también sería falso si el Hero quedara por debajo del visor, que es lo que
    pasa en cuanto alguien vuelve arriba con el teclado.
  */
  flotante && (
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const cabecera = document.querySelector('header[data-sobre-hero]');
        const hero = document.querySelector('[data-hero]');
        if (!cabecera || !hero) return;

        const alto = cabecera.offsetHeight;
        new IntersectionObserver(
          ([entrada]) => {
            const sobreHero = entrada.boundingClientRect.bottom > alto;
            cabecera.toggleAttribute('data-sobre-hero', sobreHero);
            cabecera.classList.toggle('dark', sobreHero);
          },
          { rootMargin: `-${alto}px 0px 0px 0px`, threshold: 0 },
        ).observe(hero);
      });
    </script>
  )
}

---
import { Image } from 'astro:assets';
import { degradadoPara } from '@/lib/degradado';
import { formatearFecha, type Noticia } from '@/lib/news';

interface Props {
  noticia: Noticia;
  /** Nivel de encabezado, para no romper la jerarquía del documento. */
  nivel?: 2 | 3;
}

const { noticia, nivel = 3 } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';
const href = `/noticias/${noticia.slug}`;

/**
 * Anchos de la tarjeta en la grilla (`md:grid-cols-2 lg:grid-cols-3` dentro de
 * `max-w-7xl`): 389 px en escritorio, 348 en tableta, todo el ancho en móvil.
 * Sin esto el navegador supone `100vw` y descarga una variante de más.
 */
const SIZES = '(min-width: 1024px) 389px, (min-width: 768px) 348px, 100vw';

/**
 * Respaldo para las noticias sin portada: son 144 de 166 mientras se completa
 * la carga de imágenes, así que no puede ser un hueco. Ver `@/lib/degradado`.
 */
const degradado = degradadoPara(noticia.slug);
---

<article class="tarjeta group flex flex-col overflow-hidden transition-shadow hover:shadow-lg">
  {/*
    Proporción fija 3:2 y `object-cover`: la caja la define el contenedor, no
    el archivo, así que portadas de distinta forma no descuadran la grilla ni
    provocan salto de maquetado. Las de las noticias son apaisadas, pero una
    vertical entraría igual.

    `alt=""` en las tres: el título de la tarjeta es el nombre accesible del
    enlace y va justo debajo. Repetir aquí una descripción obligaría a quien
    usa lector de pantalla a oír dos veces cada tarjeta al recorrer el listado.
    La descripción sí se usa en la página del artículo.
  */}
  <div class="aspect-[3/2] overflow-hidden">
    {
      noticia.imagen ? (
        <Image
          src={noticia.imagen}
          alt=""
          widths={[400, 800]}
          sizes={SIZES}
          loading="lazy"
          class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div
          class:list={['size-full bg-gradient-to-br', degradado]}
          aria-hidden="true"
        />
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6">
    <p class="eyebrow">{noticia.categoria}</p>

    <Titulo class="mt-2.5 font-display text-lg font-semibold text-slate-900 dark:text-white">
      {/*
        Enlace envolvente mediante pseudo-elemento: toda la tarjeta es
        clicable pero el nombre accesible del enlace sigue siendo el título.
      */}
      <a
        href={href}
        class="after:absolute after:inset-0 group-hover:text-comunidad-700 dark:group-hover:text-cosecha-400"
      >
        {noticia.titulo}
      </a>
    </Titulo>

    <p class="mt-3 line-clamp-3 text-sm text-slate-600 dark:text-slate-400">
      {noticia.resumen}
    </p>

    <time datetime={noticia.fecha} class="mt-5 text-xs text-slate-500 dark:text-slate-400">
      {formatearFecha(noticia.fecha)}
    </time>
  </div>
</article>

<style>
  article {
    position: relative;
  }
</style>

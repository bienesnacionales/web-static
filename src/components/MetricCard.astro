---
/**
 * "Metrics as Hero" (BRIEF §3): cifra en tamaño gigante con etiqueta pequeña.
 */
interface Props {
  valor: string;
  etiqueta: string;
  detalle?: string;
}

const { valor, etiqueta, detalle } = Astro.props;
---

<div class="tarjeta p-7">
  <p
    class="font-display text-3xl font-bold tracking-tight text-comunidad-700 sm:text-4xl
           dark:text-cosecha-400"
  >
    {valor}
  </p>
  <p class="mt-3 text-sm font-semibold text-slate-900 dark:text-slate-100">{etiqueta}</p>
  {detalle && <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-400">{detalle}</p>}
</div>

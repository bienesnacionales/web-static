---
/**
 * Marco de todas las páginas: réplica del tema `mbn` del sitio del Ministerio.
 *
 * La cabecera, el pie y los estilos salen tal cual del tema original
 * (`src/contenido/marco/`), y los scripts se cargan en el mismo orden que los
 * encola WordPress: los componentes del tema se buscan a sí mismos en la página
 * por sus atributos `data-mbn-*`, así que basta con que estén todos.
 */
import cabecera from '@/contenido/marco/cabecera.html?raw';
import pie from '@/contenido/marco/pie.html?raw';
import extrasPortada from '@/contenido/marco/portada.html?raw';
import estilos from '@/contenido/marco/head.html?raw';
import config from '@/contenido/marco/scripts.json';
import { SITIO_PUBLICO } from '@/lib/publicacion';
import { politicaCsp } from '@/lib/seguridad';

interface Props {
  /** Título completo del documento, tal como lo arma el sitio original. */
  titulo: string;
  descripcion?: string;
  /** Imagen para redes sociales (`og:image`), ruta del sitio. */
  imagen?: string;
  /** Clases del `<body>`: el CSS del tema depende de algunas. */
  clases?: string;
  /** La portada lleva además la encuesta de satisfacción y el aviso emergente. */
  portada?: boolean;
  /** La página incrusta publicaciones de Instagram. */
  instagram?: boolean;
  /** Excluye la página de los buscadores (ej. 404). */
  sinIndexar?: boolean;
}

const {
  titulo,
  descripcion = '',
  imagen = '',
  clases = 'wp-embed-responsive wp-theme-mbn',
  portada = false,
  instagram = false,
  sinIndexar = false,
} = Astro.props;

const urlCanonica = new URL(Astro.url.pathname, Astro.site);
const urlImagen = imagen ? new URL(imagen, Astro.site) : null;
const conFaq = clases.includes('template-faq');

/*
  Scripts del tema, en el orden de WordPress. `listados-estaticos.js` va antes
  que los buscadores de noticias y trámites: responde en el navegador las
  peticiones que ellos hacían al servidor.
*/
const componentes = [
  '/tema/vendor/bootstrap/5.3.3/js/bootstrap.bundle.min.js',
  '/tema/js/header-nav.js',
  '/tema/js/external-link.js',
  '/tema/js/components/slider.js',
  '/tema/js/components/media-cards.js',
  '/tema/js/components/icon-links.js',
];
const componentesTras = [
  '/tema/js/components/authorities.js',
  '/tema/js/components/content-tabs.js',
  '/tema/js/components/faq.js',
  '/tema/js/components/share.js',
  '/tema/js/components/gallery.js',
  '/js/listados-estaticos.js',
  '/tema/js/components/news-search.js',
  '/tema/js/components/procedure-search.js',
];
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Política de seguridad de contenido, lo más arriba posible: sólo cuenta
      para lo que el navegador encuentre después. Detalle en `seguridad.ts`.
    */}
    <meta http-equiv="content-security-policy" content={politicaCsp(import.meta.env.PUBLIC_GA_ID)} />

    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" href="/tema/images/favicon.ico" sizes="16x16 32x32" type="image/x-icon" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    {descripcion && <meta property="og:description" content={descripcion} />}
    <meta property="og:url" content={urlCanonica} />
    {urlImagen && <meta property="og:image" content={urlImagen} />}
    <meta property="og:locale" content="es_CL" />

    {/*
      Dos motivos distintos para no indexar, y el del sitio manda sobre el de la
      página. `nofollow` además de `noindex`: sin él el rastreador sigue los
      enlaces y descubre todas las páginas aunque no indexe ninguna.
    */}
    {!SITIO_PUBLICO ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      sinIndexar && <meta name="robots" content="noindex" />
    )}

    {/* Estilos del tema y el script que aplica contraste y tamaño de texto antes del primer pintado. */}
    <Fragment set:html={estilos} />
    {portada && <link rel="stylesheet" href="/uploads/pum/pum-site-styles.css" />}
    <script is:inline src="/tema/js/large-screen.js"></script>
  </head>

  <body class={clases}>
    <Fragment set:html={cabecera} />
    <slot />
    <Fragment set:html={pie} />
    {portada && <Fragment set:html={extrasPortada} />}

    {/* Asistente virtual. Sin backend, cae en su aviso de «no disponible». */}
    <script is:inline src="/chatbot/history.js"></script>
    <script is:inline src="/chatbot/conversation.js"></script>
    <script is:inline set:html={`window.MBNChatbot=${JSON.stringify(config.chatbot)};`} />
    <script is:inline src="/chatbot/chatbot.js"></script>
    {conFaq && <script is:inline src="/chatbot/faq-links.js"></script>}

    {componentes.map((src) => <script is:inline src={src}></script>)}
    <script is:inline set:html={`window.mbnPdfViewer = ${JSON.stringify(config.pdfViewer)};`} />
    <script is:inline src="/tema/js/components/pdf-viewer.js"></script>
    {componentesTras.map((src) => <script is:inline src={src}></script>)}

    {portada && <script is:inline src="/tema/js/survey.js"></script>}
    {portada && <script is:inline src="/js/aviso-portada.js"></script>}
    {instagram && <script is:inline async src="https://www.instagram.com/embed.js"></script>}
  </body>
</html>
